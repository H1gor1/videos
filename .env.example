# Configuração do servidor
PORT=3456
HOST=127.0.0.1

# Provedor TTS padrão: edge | espeak | piper | elevenlabs | openai
TTS_PROVIDER=edge
TTS_DEFAULT_VOICE=pt-BR-AntonioNeural

# Provedor LLM interno opcional: manual | gemini | openai-compatible
LLM_PROVIDER=manual
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Provedores TTS opcionais pagos/locais
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PIPER_BIN=piper
PIPER_MODEL_PATH=

# Provedor de Imagem opcional: none | comfyui
IMAGE_PROVIDER=none
COMFYUI_URL=http://127.0.0.1:8188

# Renderizador padrão: hyperframes | playwright | remotion
RENDERER=hyperframes
CHROME_PATH=/usr/bin/google-chrome
HYPERFRAMES_ROOT=/home/higorlino/openmotion

# Pastas de mídia customizadas
MUSIC_DIR=./assets/music
SFX_DIR=./assets/sfx

# Diretório de dados (personagens, séries, jobs, projetos). Padrão: ./data
# VIDEOS_DATA_DIR=
